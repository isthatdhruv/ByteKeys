# Public URL of the site, no trailing slash. Drives canonical URLs, the sitemap, robots.txt,
# llms.txt and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://bytekeys.byteknotlabs.com

# PostHog analytics (optional). Leave the key empty to turn analytics off.
# PostHog > Project settings > Project API key
NEXT_PUBLIC_POSTHOG_KEY=
# https://us.i.posthog.com (US cloud) or https://eu.i.posthog.com (EU cloud)
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Search engine verification (optional, content value of the meta tag only)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
