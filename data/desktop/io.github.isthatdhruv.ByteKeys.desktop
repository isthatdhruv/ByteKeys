[Desktop Entry]
Type=Application
Name=ByteKeys
GenericName=Laptop Control Center
Comment=Keyboard lighting, fans and performance modes for your laptop
Exec=bytekeys-gui %U
Icon=io.github.isthatdhruv.ByteKeys
Terminal=false
Categories=Settings;HardwareSettings;
Keywords=keyboard;backlight;rgb;led;lighting;laptop;brightness;fan;performance;battery;armoury;control center;
StartupNotify=true
StartupWMClass=bytekeys
SingleMainWindow=true
